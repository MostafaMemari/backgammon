# Firebase web app configuration for online multiplayer.
#
# Where to find these values:
#   Firebase console (https://console.firebase.google.com)
#   -> your project -> Project settings (gear icon) -> General
#   -> Your apps -> Web app -> SDK setup and configuration -> Config
#
# Local development: copy this file to .env and fill in real values.
#   cp .env.example .env
# (.env is git-ignored; never commit real keys.)
#
# Vercel: add the same variables in
#   Project -> Settings -> Environment Variables
#   then trigger a Redeploy so the new build picks them up.
#
# Note: in Create React App every variable must start with REACT_APP_
# to be included in the client bundle.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional - only needed if you enable Google Analytics for your project.
REACT_APP_FIREBASE_MEASUREMENT_ID=
